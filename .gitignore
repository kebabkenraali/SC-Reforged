# Godot: generated caches
.godot/
*.import
__pycache__/
*.uid

# Engine binaries and other large tools (download separately, see README)
tools/godot/*.exe
tools/blender-*/
engine/
demo/Godot.exe

# Build output and screenshots
dist/
dist.7z
shots/

# libRealSpace reference checkout + build (local-only, never commit; original
# SC.DAT must be supplied by the player at runtime, never stored here)
tools/librealspace/
tools/xr-simulator/

# Scratch files. tmp/ holds dumps with original game text: never commit those.
tmp/*
!tmp/flight_scene_gd_agentB_lineup_20261111.gd
*.log

# Copyrighted reference material (developer reference only, do not redistribute)
docs/PLAYTESTERS_GUIDE.txt
docs/SC_MANUAL.txt
docs/DEKOMPILU/*
!docs/DEKOMPILU/README.md

# Local-only material derived from the original game (disassembly, data dumps):
# helps compatibility work, never committed or distributed. Only the README.
alkuperainen_purku/*
!alkuperainen_purku/README.md
