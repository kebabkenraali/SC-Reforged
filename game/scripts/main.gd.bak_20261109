## Application root: requires a mounted original installation, then switches
## between menu, flight and model viewer screens.
##
## Automation (used for testing): pass after "--"
##   --auto=flight|viewer|menu  --map=CANYON  --plane=OBJECTS/F-16DES.IFF
##   --auto=campaign (new) | --auto=continue  --conv=N (play conversation N)  --story=N (cut-scene MIDn)  --shot_scene=N (establishing shot N)  --transport=N
##   --mission=MISSIONS/MISN-10A.IFF  --spawn_area=2  --log  --autopilot  --endless_ammo  --bomb_run  --debrief=2  --approach  --model=OBJECTS/MIG29.IFF  --cam=0..2  --frames=120  --shot=C:/path.png
extends Node

const Demo = preload("res://scripts/core/demo.gd")

const SetupScreen = preload("res://scripts/ui/setup_screen.gd")
const MainMenu = preload("res://scripts/ui/main_menu.gd")
const FlightScene = preload("res://scripts/game/flight_scene.gd")
const ModelViewer = preload("res://scripts/ui/model_viewer.gd")
const UiTheme = preload("res://scripts/ui/ui_theme.gd")
const Campaign = preload("res://scripts/game/campaign.gd")
const BaseScreen = preload("res://scripts/ui/base_screen.gd")

var current: Node
var campaign
var _base                       # base screen kept (hidden) while a campaign mission is flown
var args := {}
var _frames_left := -1
var _headless := false          # headless mode flag, set in _ready()


func _ready() -> void:
	# Keep screenshots, input and screen switching alive while the game is paused.
	process_mode = Node.PROCESS_MODE_ALWAYS
	
	# Headless detection: skip UI creation in headless mode
	_headless = DisplayServer.get_name() == "headless"
	print("DEBUG main.gd: headless=", _headless)
	
	for a in OS.get_cmdline_args():
		var arg = a.trim_prefix("--")
		if arg.is_empty():
			continue
		var kv := arg.split("=", true, 1)
		args[kv[0]] = kv[1] if kv.size() > 1 else "1"
		print("DEBUG parsed arg: ", kv[0], " = ", kv[1])
	if args.has("speed"):
		# test runs only: simulate faster than real time
		Engine.time_scale = float(args.speed)
		Engine.max_physics_steps_per_frame = 8 * int(ceil(float(args.speed)))
	if args.has("fast"):
		# --fast: alias for --speed=10 (10x simulation speed)
		Engine.time_scale = 10.0
		Engine.max_physics_steps_per_frame = 80
	if args.has("ultrafast"):
		# --ultrafast: alias for --speed=100 (100x simulation speed)
		Engine.time_scale = 100.0
		Engine.max_physics_steps_per_frame = 800
	if Demo.enabled():
		get_window().title = "Strike Commander Reforged – Demo"
	if not Demo.enabled():
		get_window().title = "Strike Commander Reforged"
	get_window().min_size = Vector2i(1024, 600)

	if args.has("dir"):
		SCData.mount(args.dir)
	if not SCData.is_mounted() and not SCData.auto_mount():
		if _headless:
			# No UI in headless mode: fail early if data not mounted
			push_error("Game data not mounted. Use --dir=path argument.")
			get_tree().quit(1)
		else:
			show_setup()
	else:
		_start()
	
	# In headless mode, ALWAYS drive the simulation loop if we have a flight scene
	if _headless:
		# Always wait for frames in headless mode
		print("DEBUG args: ", args)
		_frames_left = int(args.get("frames", "90"))
		if _frames_left > 0:
			print("HEADLESS: Starting frame loop for ", _frames_left, " frames")
			_wait_for_frames()
		else:
			# No frames specified, just wait a bit
			OS.delay_msec(1000)
			get_tree().quit(0)
	
	if args.has("shot"):
		_frames_left = int(args.get("frames", "90"))
		print("DEBUG: SHOT ARGS FOUND: _frames_left=", _frames_left, " shot=", args.shot)
		print("DEBUG: HEADLESS mode:", _headless, " auto=", args.get("auto", "none"))
		print("DEBUG: all args: ", args)
		# In headless mode, run _wait_for_frames() synchronously (no await)
		if _headless and _frames_left > 0:
			print("DEBUG: CALLING _wait_for_frames()")
			_wait_for_frames()


func _start() -> void:
	match args.get("auto", ""):
		"flight":
			start_flight(args.get("map", "CANYON"), args.get("plane", "OBJECTS/F-16DES.IFF"), args.get("mission", ""))
		"viewer":
			show_viewer()
		"campaign":
			start_campaign(true)
		"continue":
			start_campaign(false)
		_:
			if not _headless:
				show_menu()
			else:
				# Default to flight mode in headless
				start_flight("CANYON", "OBJECTS/F-16DES.IFF", "")


func _switch(node: Node) -> void:
	if current != null:
		current.queue_free()
	current = node
	add_child(node)


func show_setup() -> void:
	var s = SetupScreen.new()
	s.mounted.connect(show_menu)
	_switch(s)


func show_menu() -> void:
	_drop_base()
	var m = MainMenu.new()
	m.start_flight.connect(start_flight)
	m.open_viewer.connect(show_viewer)
	m.start_campaign.connect(start_campaign)
	_switch(m)


## Campaign: base screens, conversations and missions from GAMEFLOW.
func start_campaign(new_game: bool) -> void:
	campaign = Campaign.new()
	var resume: bool = not new_game and campaign.load_saved()
	var b = BaseScreen.new()
	b.campaign = campaign
	b.fly_requested.connect(_fly_campaign_mission)
	b.quit_requested.connect(show_menu)
	_switch(b)
	_base = b
	if args.has("conv"):
		await b.play_conversation(int(args.conv))
		return
	if args.has("story"):
		await b.play_story(int(args.story))
		return
	if args.has("transport"):
		await b.play_transport(int(args.transport))
		return
	if args.has("shot_scene"):
		await b.play_cutscene(int(args.shot_scene))
		return
	if resume and campaign.screen >= 0:
		b._build_screen(campaign.screen)
	elif resume:
		campaign.enter_stage(campaign.stage)
	else:
		campaign.start_new()


func _fly_campaign_mission(file: String) -> void:
	_base.visible = false
	_base.process_mode = Node.PROCESS_MODE_DISABLED
	var f = FlightScene.new()
	f.mission_file = file
	f.campaign_mode = true
	f.camera_mode = int(args.get("cam", "0"))
	f.mission_result.connect(_campaign_flight_done.bind(f))
	f.restart.connect(func(): f.queue_free(); _fly_campaign_mission(file))
	add_child(f)


func _campaign_flight_done(success: bool, f: Node) -> void:
	f.queue_free()
	_base.visible = true
	_base.process_mode = Node.PROCESS_MODE_INHERIT
	_base.flight_done.emit(success)


func _drop_base() -> void:
	if _base != null and is_instance_valid(_base) and _base != current:
		_base.queue_free()
	_base = null


func start_flight(area: String, plane: String, mission := "") -> void:
	var f = FlightScene.new()
	f.area = area
	f.plane_model = plane
	f.mission_file = mission
	f.spawn_area = int(args.get("spawn_area", "-1"))
	f.debug_log = args.has("log")
	f.autopilot = args.has("autopilot")
	f.endless_ammo = args.has("infinite_ammo") or args.has("endless_ammo") or args.has("autopilot")
	f.bomb_run = args.has("bomb_run")
	f.debrief_after = float(args.get("debrief", "-1"))
	f.approach = args.has("approach")
	f.camera_mode = int(args.get("cam", "0"))
	f.exit_to_menu.connect(show_menu)
	f.restart.connect(start_flight.bind(area, plane, mission))
	_switch(f)


func show_viewer() -> void:
	var v = ModelViewer.new()
	v.initial_model = args.get("model", "")
	v.back.connect(show_menu)
	_switch(v)


func _process(_delta: float) -> void:
	if _frames_left > 0:
		_frames_left -= 1
		if _frames_left == 0:
			await RenderingServer.frame_post_draw
			var vp := get_viewport()
			if vp != null:
				var tex := vp.get_texture()
				if tex != null:
					var img := tex.get_image()
					if img != null:
						img.save_png(args.shot)
						print("Screenshot saved: ", args.shot)
			get_tree().quit()

func _wait_for_frames() -> void:
	print("=== _wait_for_frames() START ===")
	# Drive simulation manually using OS.delay_msec (no await in the loop)
	var frame_done = 0
	var target_frames = _frames_left
	
	print("TARGET FRAMES: ", target_frames)
	print("Headless: ", DisplayServer.get_name())
	
	# Find the FlightScene child
	var flight_scene = null
	for child in get_children():
		if child.has_signal("exit_to_menu"):
			flight_scene = child
			break
	
	if flight_scene == null:
		print("ERROR: No FlightScene found!")
		get_tree().quit(1)
		return
	
	print("Found FlightScene at index: ", get_children().find(flight_scene))
	print("Flight player: ", "alive" if flight_scene.player and flight_scene.player.alive else "not alive")
	if flight_scene.player:
		print("Player pos: ", flight_scene.player.global_position)
		print("Player on_ground: ", flight_scene.player.on_ground)
		print("Player speed: ", flight_scene.player.speed())
	if flight_scene.home_runway:
		print("Home runway: ", flight_scene.home_runway.global_position)
	
	# Enable landing autopilot
	flight_scene.autopilot_land = true
	print("Enabled autopilot_land")
	
	var landing_complete = false
	var crash_detected = false
	
	while frame_done < target_frames and is_inside_tree():
		# Drive physics on the flight scene
		var dt = 1.0 / 60.0
		flight_scene._physics_process(dt)
		frame_done += 1
		
		# Progress update every 50 frames
		if frame_done % 50 == 0 or frame_done == 1:
			var spd = 0
			var agl = 0
			var on_gnd = false
			if flight_scene.player:
				spd = flight_scene.player.speed()
				on_gnd = flight_scene.player.on_ground
				if flight_scene.terrain:
					agl = flight_scene.player.global_position.y - flight_scene.terrain.height_at(flight_scene.player.global_position.x, flight_scene.player.global_position.z)
				print("  Frame ", frame_done, "/", target_frames, " | Speed: ", spd, " m/s | AGL: ", agl, " m | OnGround: ", on_gnd)
				# Check for landing
				if on_gnd and agl < 10.0 and spd < 20.0:
					landing_complete = true
					print("*** LANDING DETECTED at frame ", frame_done, " ***")
					break
				# Check for crash
				if agl < -100.0:
					crash_detected = true
					print("*** CRASH DETECTED at frame ", frame_done, " ***")
					break
		
		# Yield to Godot briefly (non-blocking)
		OS.delay_msec(1)
	
	# Final status
	if not landing_complete and not crash_detected:
		print("Simulation ended without landing or crash")
		if flight_scene.player:
			print("  Final speed: ", flight_scene.player.speed())
			print("  Final on_ground: ", flight_scene.player.on_ground)
			var final_agl = 0
			if flight_scene.terrain:
				final_agl = flight_scene.player.global_position.y - flight_scene.terrain.height_at(flight_scene.player.global_position.x, flight_scene.player.global_position.z)
			print("  Final AGL: ", final_agl)
	
	# Screenshot when done
	print("\n=== TAKING SCREENSHOT ===")
	var vp = get_viewport()
	if vp:
		var tex = vp.get_texture()
		if tex != null:
			var img = tex.get_image()
			if img:
				img.save_png(args.shot)
				print("Screenshot saved: ", args.shot)
				print("Frame count: ", frame_done, "/", target_frames)
			else:
				print("WARNING: No image from texture")
		else:
			print("WARNING: No texture from viewport")
	else:
		print("WARNING: No viewport available")
	get_tree().quit(0)


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("screenshot"):
		var dir := OS.get_user_data_dir() + "/screenshots"
		DirAccess.make_dir_recursive_absolute(dir)
		var path := dir + "/sc_%s.png" % Time.get_datetime_string_from_system().replace(":", "-")
		get_viewport().get_texture().get_image().save_png(path)
		print("Screenshot saved: ", path)


